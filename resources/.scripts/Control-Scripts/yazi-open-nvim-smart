#!/bin/bash
# Smart nvim opener - opens in tmux window if in tmux, otherwise opens normally

if [ -n "$TMUX" ]; then
    # We're in tmux - new-window already focuses the window it creates
    # (selecting by name could jump to an older "nvim" window instead)
    tmux new-window -c "$(pwd)" -n "nvim" nvim "$@"
else
    # Not in tmux - open normally
    exec nvim "$@"
fi
