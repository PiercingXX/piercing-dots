#!/usr/bin/env bash

iDIR="$HOME/.config/waybar/scripts/icons"

# Current brightness as a percentage (brightnessctl -m: dev,class,raw,percent%,max)
get_percent() {
	brightnessctl -m | awk -F, '{gsub("%","",$4); print $4; exit}'
}

get_backlight() {
	echo "$(get_percent)%"
}

# Icon by percentage
get_icon() {
	local current
	current=$(get_percent)
	if (( current <= 20 )); then
		icon="$iDIR/brightness-20.png"
	elif (( current <= 40 )); then
		icon="$iDIR/brightness-40.png"
	elif (( current <= 60 )); then
		icon="$iDIR/brightness-60.png"
	elif (( current <= 80 )); then
		icon="$iDIR/brightness-80.png"
	else
		icon="$iDIR/brightness-100.png"
	fi
}

# Notify (shares the "osd" slot with the Control-Scripts volume/brightness OSD)
notify_user() {
	local pct
	pct=$(get_percent)
	notify-send -h string:x-canonical-private-synchronous:osd -h "int:value:$pct" -u low -i "$icon" "Brightness : ${pct}%"
}

# Increase brightness
inc_backlight() {
	brightnessctl -q set 10%+ && get_icon && notify_user
}

# Decrease brightness
dec_backlight() {
	brightnessctl -q set 10%- && get_icon && notify_user
}

# Execute accordingly
if [[ "$1" == "--get" ]]; then
	get_percent
elif [[ "$1" == "--inc" ]]; then
	inc_backlight
elif [[ "$1" == "--dec" ]]; then
	dec_backlight
else
	get_backlight
fi
