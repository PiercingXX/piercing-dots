#!/usr/bin/env bash

iDIR="$HOME/.config/waybar/scripts/icons"
DEV='*::kbd_backlight'

# Percentage (brightnessctl -m: dev,class,raw,percent%,max)
get_percent() {
	brightnessctl -m -d "$DEV" | awk -F, '{gsub("%","",$4); print $4; exit}'
}

get_backlight() {
	echo "$(get_percent)%"
}

# Get icons
get_icon() {
	local current
	current=$(get_percent)
	if (( current <= 33 )); then
		icon="$iDIR/brightness-20.png"
	elif (( current <= 66 )); then
		icon="$iDIR/brightness-60.png"
	else
		icon="$iDIR/brightness-100.png"
	fi
}

# Notify
notify_user() {
	notify-send -h string:x-canonical-private-synchronous:osd -u low -i "$icon" "Keyboard Brightness : $(get_percent)%"
}

# Increase brightness
inc_backlight() {
	brightnessctl -q -d "$DEV" set 33%+ && get_icon && notify_user
}

# Decrease brightness
dec_backlight() {
	brightnessctl -q -d "$DEV" set 33%- && get_icon && notify_user
}

# Execute accordingly
if [[ "$1" == "--get" ]]; then
	brightnessctl -d "$DEV" g
elif [[ "$1" == "--inc" ]]; then
	inc_backlight
elif [[ "$1" == "--dec" ]]; then
	dec_backlight
else
	get_backlight
fi
