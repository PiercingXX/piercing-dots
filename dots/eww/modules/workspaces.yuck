(defwidget workspaces []
  (box 
    :orientation "h" 
    :space-evenly false 
    :class "workspaces" 
    :hexpand true
    (for workspace in {hyprland.workspaces}
      (button 
        :class "workspace ${hyprland.active == workspace.id ? "current" : ""}"
        :onclick "hyprctl dispatch 'hl.dsp.focus({ workspace = ${workspace.id} })'"
        "${workspace.id}"
      )
    )
  )
)
