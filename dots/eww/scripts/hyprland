#!/bin/bash
# Hyprland 0.55+ takes Lua dispatchers: hyprctl dispatch 'hl.dsp.<name>({ ... })'

if [[ $1 == 'window' ]]; then hyprctl dispatch "hl.dsp.focus({ window = 'address:$2' })"; fi
if [[ $1 == 'workspace' ]]; then hyprctl dispatch "hl.dsp.focus({ workspace = '$2' })"; fi
if [[ $1 == 'move' ]]; then hyprctl dispatch "hl.dsp.window.move({ window = 'address:$3', workspace = '$2', follow = false })" && eww update selected=""; fi
if [[ $1 == 'special' ]]; then hyprctl dispatch "hl.dsp.window.move({ window = 'address:$2', workspace = 'special', follow = false })"; fi
if [[ $1 == 'close' ]]; then hyprctl dispatch "hl.dsp.window.close({ window = 'address:$2' })"; fi
if [[ $1 == 'update' ]]; then eww update selected=$2; fi
