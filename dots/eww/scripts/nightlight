#!/bin/bash
# Shared nightlight toggle for eww (wlsunset).

state() {
  if pgrep -x wlsunset >/dev/null 2>&1; then
    echo true
  else
    echo false
  fi
}

toggle() {
  if [[ $(state) == true ]]; then
    eww update nightlight=false
    pkill wlsunset
  else
    eww update nightlight=true
    wlsunset -t 3400 &
  fi
}

case "${1:-}" in
  toggle) toggle ;;
  get) state ;;
  *) echo "Usage: $0 [toggle|get]" >&2; exit 1 ;;
esac
