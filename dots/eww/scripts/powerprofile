#!/bin/bash

PROFILE="$(powerprofilesctl get 2>/dev/null || echo balanced)"

toggle() {
  case "$PROFILE" in
    performance)
      next=balanced
      ;;
    balanced)
      next=power-saver
      ;;
    *)
      next=performance
      ;;
  esac
  powerprofilesctl set "$next"
  command -v eww >/dev/null 2>&1 && eww update powerprofile="$next"
}

case "${1:-}" in
  toggle) toggle ;;
  get) echo "$PROFILE" ;;
  *) echo "Usage: $0 [toggle|get]" >&2; exit 1 ;;
esac
