#!/bin/bash
# GitHub.com/PiercingXX
# eww deflisten: {"packages": N, "updates": N, ...} every 10 minutes.
counter="$HOME/.scripts/Control-Scripts/update-count.sh"

while true; do
    if [ -x "$counter" ]; then
        "$counter" --json
    else
        echo '{"packages": 0, "updates": 0}'
    fi
    sleep 600
done
