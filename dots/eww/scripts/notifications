#!/bin/bash
# Notification actions for eww.
# Prefers swaync when it owns the session bus; otherwise talks to eww's python daemon.

set -u

have_swaync() {
  pgrep -x swaync >/dev/null 2>&1 && command -v swaync-client >/dev/null 2>&1
}

dismiss() {
  if have_swaync; then
    return 0
  fi
  dbus-send --session --type=method_call \
    --dest=org.freedesktop.Notifications \
    /org/freedesktop/Notifications \
    org.freedesktop.Notifications.DismissPopup \
    uint32:"$1"
}

close() {
  if have_swaync; then
    return 0
  fi
  dbus-send --session --type=method_call \
    --dest=org.freedesktop.Notifications \
    /org/freedesktop/Notifications \
    org.freedesktop.Notifications.CloseNotification \
    uint32:"$1"
}

action() {
  if have_swaync; then
    return 0
  fi
  dbus-send --session --type=method_call \
    --dest=org.freedesktop.Notifications \
    /org/freedesktop/Notifications \
    org.freedesktop.Notifications.InvokeAction \
    uint32:"$1" string:"$2"
  eww update info-center_rev=false
}

clear_all() {
  if have_swaync; then
    swaync-client -C >/dev/null 2>&1 || true
    return 0
  fi
  dbus-send --session --type=method_call \
    --dest=org.freedesktop.Notifications \
    /org/freedesktop/Notifications \
    org.freedesktop.Notifications.ClearAll
}

toggle_dnd() {
  if have_swaync; then
    swaync-client -d >/dev/null 2>&1 || swaync-client --toggle-dnd >/dev/null 2>&1 || true
    return 0
  fi
  dbus-send --session --type=method_call \
    --dest=org.freedesktop.Notifications \
    /org/freedesktop/Notifications \
    org.freedesktop.Notifications.ToggleDND
}

remove_id() {
  if have_swaync; then
    return 0
  fi
  dbus-send --session --type=method_call \
    --dest=org.freedesktop.Notifications \
    /org/freedesktop/Notifications \
    org.freedesktop.Notifications.RemovePopupID \
    uint32:"$1"
}

case "${1:-}" in
  dismiss) dismiss "${2:-0}" ;;
  close) close "${2:-0}" ;;
  action) action "${2:-0}" "${3:-}" ;;
  clear) clear_all ;;
  toggle) toggle_dnd ;;
  pop) remove_id "${2:-0}" ;;
  *) echo "Usage: $0 [dismiss|close|action|clear|toggle|pop] ..." >&2; exit 1 ;;
esac
