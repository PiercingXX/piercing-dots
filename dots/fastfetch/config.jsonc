{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "color": {
      "1": "light_white",
      "2": "light_white",
      "3": "white",
      "4": "white",
      "5": "dim_white",
      "6": "light_black",
      "7": "light_black",
      "8": "black",
      "9": "black"
    }
  },
  "display": {
    "bar": {
      "type": "graphs",
      "color": {
        "elapsed": "light_white",
        "total": "light_black",
        "border": "white"
      }
    },
    "brightColor": false,
    "separator": "  ",
    "color": {
      "keys": "dim_white",
      "title": "light_white",
      "output": "white",
      "separator": "dim_white"
    },
    "percent": {
      "color": {
        "green": "light_white",
        "yellow": "white",
        "red": "light_black"
      }
    }
  },
  "modules": [
    {
      "type": "title",
      "color": {
        "user": "light_white",
        "at": "dim_white",
        "host": "white"
      }
    },
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "de",
    "wm",
    "wmtheme",
    "theme",
    "icons",
    "font",
    "cursor",
    "terminal",
    "terminalfont",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    "localip",
    "battery",
    "poweradapter",
    "locale",
    "break"
  ]
}
